DATABASE_URL="postgresql://kounouz:kounouz@localhost:5433/kounouz_alafiya?schema=public"
PORT=3000

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# URL publique du site, encodée dans les QR imprimés.
PUBLIC_APP_URL="http://localhost:5173"

# Origines autorisées pour CORS, séparées par des virgules.
# Vide = toutes les origines (développement local uniquement).
CORS_ORIGINS=""

# Commission Kounouz prélevée sur chaque vente (0.2 = 20 %)
KOUNOUZ_COMMISSION_RATE="0.2"

# Limitation de débit globale : THROTTLE_LIMIT requêtes par THROTTLE_TTL ms.
# Les routes sensibles (login, /verify) ont leurs propres plafonds, plus bas.
THROTTLE_TTL="60000"
THROTTLE_LIMIT="120"
