# ---------------------------------------------------------------------------
# Kounouz Alafiya — variables de déploiement (docker compose)
#   cp .env.deploy.example .env   puis renseigner les secrets
# ---------------------------------------------------------------------------

# --- Base de données -------------------------------------------------------
POSTGRES_USER=kounouz
POSTGRES_PASSWORD=change-moi-mot-de-passe-solide
POSTGRES_DB=kounouz_alafiya
POSTGRES_PORT=5433

# --- Secrets JWT (OBLIGATOIRES) --------------------------------------------
# Générer deux valeurs distinctes, par ex. :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Signature des liens vers les fichiers privés. Vide = secret JWT d'accès.
FILES_SIGNING_SECRET=

# --- URLs ------------------------------------------------------------------
# URL publique du site : elle est encodée dans les QR codes imprimés.
# À fixer AVANT toute impression de QR.
PUBLIC_APP_URL=http://localhost
# Chemin de l'API vu du navigateur. Laisser /api : nginx relaie vers backend.
VITE_API_URL=/api
# Origines autorisées (CORS). Vide = tout autoriser (développement seulement).
# En production : CORS_ORIGINS=https://kounouzalafiya.com
CORS_ORIGINS=

# --- Règles métier ---------------------------------------------------------
# Commission Kounouz prélevée sur chaque vente (0.2 = 20 %).
KOUNOUZ_COMMISSION_RATE=0.2

# --- Limitation de débit ---------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# --- Proxy -------------------------------------------------------------------
# Nombre de proxys devant l'API, pour lire l'IP réelle des visiteurs :
#   1 = nginx seul (site servi directement sur le port 80)
#   2 = proxy HTTPS sur l'hôte (Caddy) + nginx — cas du VPS (GUIDE_DEPLOIEMENT_VPS.md)
TRUST_PROXY=1

# --- Ports publiés ---------------------------------------------------------
# PostgreSQL et l'API n'écoutent que sur 127.0.0.1 (voir docker-compose.yml).
# Sur un VPS derrière Caddy : FRONTEND_PORT=127.0.0.1:8080
FRONTEND_PORT=80
BACKEND_PORT=3000
